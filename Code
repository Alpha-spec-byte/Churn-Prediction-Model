Step 1: Prepare the Dataset
import pandas as pd
import numpy as np

# Set seed for consistent results
np.random.seed(42)
n_users = 1000

# Generate Synthetic Data
data = {
    'user_id': range(101, 101 + n_users),
    'login_frequency': np.random.randint(1, 30, n_users), # Logins per month
    'course_engagement_rate': np.random.uniform(0.1, 1.0, n_users), # % of course finished
    'avg_quiz_score': np.random.uniform(40, 100, n_users),
    'last_login_days_ago': np.random.randint(0, 45, n_users),
    'support_tickets': np.random.randint(0, 4, n_users)
}
df = pd.DataFrame(data)

# Logic for "has_churned" (Target Variable)
# Users are more likely to churn (1) if they haven't logged in for > 25 days 
# or if their engagement is very low (< 20%).
df['has_churned'] = (
    (df['last_login_days_ago'] > 25) | 
    (df['course_engagement_rate'] < 0.25) |
    ((df['avg_quiz_score'] < 55) & (df['login_frequency'] < 5))
).astype(int)

# Save the file
df.to_csv('lms_engagement_data.csv', index=False)

print("✅ 'lms_engagement_data.csv' created!")
print(f"Churn Rate: {df['has_churned'].mean():.1%}")
